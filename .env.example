APP_NAME=CV-AI-Backend
ENVIRONMENT=development

OPENAI_API_KEY=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-nano

MAX_CONTEXT_CHUNKS=5
MAX_OUTPUT_TOKENS=220

SCOPE_CLASSIFIER_ENABLED=true
SCOPE_CLASSIFIER_MODEL=gpt-4o-mini
MAX_SCOPE_CLASSIFIER_TOKENS=80

RATE_LIMIT=5/minute

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kutay_smart_cv

REDIS_URL=redis://redis:6379

ALLOWED_ORIGINS=http://localhost:3000

GOOGLE_CALENDAR_TOKEN_PATH=token.json
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_SCOPES=["https://www.googleapis.com/auth/calendar"]

CALENDAR_TIMEZONE=Europe/London
CALENDAR_WORKDAY_START_HOUR=9
CALENDAR_WORKDAY_END_HOUR=18
